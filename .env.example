# PostgreSQL
POSTGRES_DB=benzine
POSTGRES_USER=benzine
POSTGRES_PASSWORD=change-me

# JWT (genereer met: openssl rand -base64 48)
JWT_KEY=change-me-to-a-long-random-string-min-32-chars

# Origin van de Angular-frontend voor CORS (alleen relevant als iets de API
# rechtstreeks cross-origin benadert; de frontend zelf praat via de nginx-proxy
# met dezelfde origin, dus CORS speelt daar geen rol).
# Zet dit op het publieke adres waarop de frontend bereikbaar is, bv.
# https://benzine.streve.nl
FRONTEND_ORIGIN=http://localhost:8081

# Poorten op de host
API_PORT=5080
FRONTEND_PORT=8081

ASPNETCORE_ENVIRONMENT=Production
