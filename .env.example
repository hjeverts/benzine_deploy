# Docker Compose project name. Compose prefixes named volumes with this, so
# pinning it keeps the existing Postgres volume intact even though this repo
# (and its directory on disk) was renamed from benzine_deploy to
# vehictory_deploy. Verify the real volume name first with
# `docker volume ls | grep postgres_data_benzine_pg18` before deploying — if
# it's prefixed with something other than "benzine_deploy", use that value
# here instead. Do not remove this once set; a mismatch here silently spins
# up a fresh empty database instead of reusing the real one.
COMPOSE_PROJECT_NAME=benzine_deploy

# PostgreSQL
POSTGRES_DB=benzine
POSTGRES_USER=benzine
POSTGRES_PASSWORD=change-me

# JWT (genereer met: openssl rand -base64 48)
JWT_KEY=change-me-to-a-long-random-string-min-32-chars

# Origin van de Angular-frontend voor CORS (alleen relevant als iets de API
# rechtstreeks cross-origin benadert; de frontend zelf praat via de nginx-proxy
# met dezelfde origin, dus CORS speelt daar geen rol).
# Zet dit op het publieke adres waarop de frontend bereikbaar is, bv.
# https://vehictory.com
FRONTEND_ORIGIN=http://localhost:8081

# Poorten op de host
API_PORT=5080
FRONTEND_PORT=8081

# SMTP voor wachtwoord-resetmails
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_SSL=true
EMAIL_USERNAME=gebruikersnaam
EMAIL_PASSWORD=change-me
EMAIL_FROM=no-reply@example.com
EMAIL_FRONTEND_URL=https://vehictory.com

# Eerste beheerder(s), kommagescheiden
ADMIN_EMAILS=admin@streve.nl

ASPNETCORE_ENVIRONMENT=Production
